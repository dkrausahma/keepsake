<?xml version="1.0" encoding="utf-8"?>
<!--
  Package sources for Keepsake (SEC-028): only nuget.org, regardless of machine-wide feeds, and every package
  is mapped to it explicitly so a same-named package on another feed can never be picked up.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
