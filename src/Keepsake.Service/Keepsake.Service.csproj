<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <RootNamespace>Keepsake.Service</RootNamespace>
    <AssemblyName>keepsake-service</AssemblyName>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Keepsake.Core\Keepsake.Core.csproj" />
    <ProjectReference Include="..\Keepsake.Protocol\Keepsake.Protocol.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="System.Security" />
    <Reference Include="System.ServiceProcess" />
    <Reference Include="System.Management" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="MailKit" Version="4.18.0" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Keepsake.Service.Tests" />
  </ItemGroup>

</Project>
