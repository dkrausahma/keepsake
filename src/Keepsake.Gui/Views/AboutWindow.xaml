<Window x:Class="Keepsake.Gui.Views.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="About Keepsake" Width="520" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Style="{StaticResource KeepsakeWindow}" Icon="/Assets/keepsake.ico">
    <StackPanel>
        <!-- Brand band: the corporate stripes over the full width. -->
        <Grid Height="6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*" />
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Rectangle Grid.Column="0" Fill="{StaticResource AccentBrush}" />
            <Rectangle Grid.Column="1" Fill="{StaticResource BrandPinkBrush}" />
            <Rectangle Grid.Column="2" Fill="{StaticResource BrandLightPinkBrush}" />
        </Grid>

        <StackPanel Margin="28,22,28,24">
            <StackPanel Orientation="Horizontal">
                <Image Source="/Assets/mark.png" Width="40" Height="40" Margin="0,0,10,0" RenderOptions.BitmapScalingMode="HighQuality" />
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Keepsake Backup" FontSize="20" FontWeight="SemiBold" />
                    <TextBlock x:Name="VersionText" Style="{StaticResource Muted}" />
                </StackPanel>
            </StackPanel>
            <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,12,0,0"
                       Text="Encrypted, deduplicated and compressed backups to local disks, USB drives, network shares and SFTP." />

            <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Margin="0,18,0,18" />

            <TextBlock Text="Developed by" Style="{StaticResource FieldLabel}" Margin="0,0,0,8" />
            <Image Source="/Assets/logo-color.png" Width="210" HorizontalAlignment="Left" Margin="0,0,0,12" RenderOptions.BitmapScalingMode="HighQuality" />
            <TextBlock TextWrapping="Wrap" LineHeight="20">
                <Run FontWeight="SemiBold" Text="Kraus-Ahma IT Consulting &amp; Anwendungsentwicklung" /><LineBreak />
                <Run Text="Dominique Kraus-Ahma" /><LineBreak />
                <Run Text="Kapuzinerstraße 2d" /><LineBreak />
                <Run Text="94032 Passau, Germany" />
            </TextBlock>

            <Grid Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="80" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="Phone" Style="{StaticResource Muted}" Margin="0,2" />
                <TextBlock Grid.Row="0" Grid.Column="1" Margin="0,2">
                    <Hyperlink NavigateUri="tel:+491721853648" RequestNavigate="OnNavigate" Foreground="{StaticResource AccentBrush}">+49 172 1853648</Hyperlink>
                </TextBlock>
                <TextBlock Grid.Row="1" Text="Web" Style="{StaticResource Muted}" Margin="0,2" />
                <TextBlock Grid.Row="1" Grid.Column="1" Margin="0,2">
                    <Hyperlink NavigateUri="https://www.kraus-ahma.com" RequestNavigate="OnNavigate" Foreground="{StaticResource AccentBrush}">www.kraus-ahma.com</Hyperlink>
                </TextBlock>
                <TextBlock Grid.Row="2" Text="LinkedIn" Style="{StaticResource Muted}" Margin="0,2" />
                <TextBlock Grid.Row="2" Grid.Column="1" Margin="0,2">
                    <Hyperlink NavigateUri="https://www.linkedin.com/in/dominique-kraus-ahma" RequestNavigate="OnNavigate" Foreground="{StaticResource AccentBrush}">linkedin.com/in/dominique-kraus-ahma</Hyperlink>
                </TextBlock>
            </Grid>

            <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Margin="0,18,0,14" />

            <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" FontSize="11.5"
                       Text="Includes BouncyCastle.Cryptography, SSH.NET, MailKit, MimeKit, ZstdSharp and System.Text.Json, each under the MIT license." />
            <DockPanel Margin="0,16,0,0">
                <Button DockPanel.Dock="Right" Content="Close" Style="{StaticResource PrimaryButton}" IsDefault="True" IsCancel="True" Click="OnClose" Padding="22,6" />
                <TextBlock x:Name="CopyrightText" Style="{StaticResource Muted}" VerticalAlignment="Center" />
            </DockPanel>
        </StackPanel>
    </StackPanel>
</Window>
