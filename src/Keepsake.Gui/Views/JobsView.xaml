<UserControl x:Class="Keepsake.Gui.Views.JobsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel>
        <Grid DockPanel.Dock="Top" Margin="0,0,0,18">
            <StackPanel>
                <TextBlock Text="Backup jobs" Style="{StaticResource PageTitle}" />
                <TextBlock Text="Each job backs up selected folders into its own encrypted repository." Style="{StaticResource Muted}" />
            </StackPanel>
            <Button Content="+  New job" Command="{Binding NewJobCommand}" Style="{StaticResource PrimaryButton}"
                    HorizontalAlignment="Right" VerticalAlignment="Center" Padding="16,8" />
        </Grid>

        <Grid>
            <ScrollViewer VerticalScrollBarVisibility="Auto" FocusVisualStyle="{x:Null}">
                <ItemsControl ItemsSource="{Binding Items}" Focusable="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse Style="{StaticResource StatusDot}" Fill="{Binding StateKey, Converter={StaticResource StateBrush}}" />
                                            <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding StateText}" Margin="12,2,0,0" Foreground="{Binding StateKey, Converter={StaticResource StateBrush}}" />
                                        </StackPanel>
                                        <TextBlock Text="{Binding Destination, StringFormat='→  {0}'}" Style="{StaticResource Muted}" Margin="17,4,0,0" TextTrimming="CharacterEllipsis" />

                                        <!-- Running: progress -->
                                        <StackPanel Margin="17,10,0,0" Visibility="{Binding IsRunning, Converter={StaticResource Visible}}">
                                            <ProgressBar IsIndeterminate="True" Width="320" HorizontalAlignment="Left" />
                                            <TextBlock Text="{Binding ProgressText}" Margin="0,6,0,0" />
                                            <TextBlock Text="{Binding CurrentPath}" Style="{StaticResource Muted}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                                        </StackPanel>

                                        <Grid Margin="17,10,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
                                            </Grid.RowDefinitions>
                                            <TextBlock Text="Last run" Style="{StaticResource Muted}" Margin="0,0,16,2" />
                                            <TextBlock Grid.Column="1" Text="{Binding LastRunText}" />
                                            <TextBlock Grid.Row="1" Text="Schedule" Style="{StaticResource Muted}" Margin="0,0,16,2" />
                                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Schedule}" TextWrapping="Wrap" />
                                            <TextBlock Grid.Row="2" Text="Next" Style="{StaticResource Muted}" Margin="0,0,16,2" />
                                            <TextBlock Grid.Row="2" Grid.Column="1">
                                                <Run Text="{Binding NextRunText, Mode=OneWay}" /><Run Text="  ·  " Foreground="{StaticResource MutedBrush}" /><Run Text="{Binding LastSuccessText, Mode=OneWay}" Foreground="{StaticResource MutedBrush}" />
                                            </TextBlock>
                                            <TextBlock Grid.Row="3" Grid.ColumnSpan="2" Text="{Binding LastMessage}" Foreground="{Binding StateKey, Converter={StaticResource StateBrush}}"
                                                       TextWrapping="Wrap" Margin="0,6,0,0" Visibility="{Binding LastMessage, Converter={StaticResource Visible}}" />
                                        </Grid>
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" VerticalAlignment="Top" Margin="16,0,0,0">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                            <Button Content="Run now" Command="{Binding RunCommand}" Style="{StaticResource PrimaryButton}" Margin="0,0,6,0" />
                                            <Button Content="Full backup" Command="{Binding RunFullCommand}" Margin="0,0,6,0" ToolTip="Re-read every file instead of trusting size and modification time" />
                                            <Button Content="Cancel" Command="{Binding CancelCommand}" Style="{StaticResource DangerButton}" />
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                                            <Button Content="Edit" Command="{Binding EditCommand}" Style="{StaticResource LinkButton}" Margin="0,0,16,0" />
                                            <Button Content="Check" Command="{Binding CheckCommand}" Style="{StaticResource LinkButton}" Margin="0,0,16,0" ToolTip="Verify the repository now" />
                                            <Button Content="Clean up" Command="{Binding PruneCommand}" Style="{StaticResource LinkButton}" Margin="0,0,16,0" ToolTip="Apply the retention rules and free space now" />
                                            <Button Content="History" Command="{Binding HistoryCommand}" Style="{StaticResource LinkButton}" Margin="0,0,16,0" />
                                            <Button Content="Restore" Command="{Binding RestoreCommand}" Style="{StaticResource LinkButton}" Margin="0,0,16,0" />
                                            <Button Content="Delete" Command="{Binding DeleteCommand}" Style="{StaticResource LinkButton}" Foreground="{StaticResource DangerBrush}" />
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- Empty state: after the list so it is on top and receives the clicks (the list's ScrollViewer covers the whole area). -->
            <Border Style="{StaticResource Card}" Padding="32" VerticalAlignment="Top" Visibility="{Binding IsEmpty, Converter={StaticResource Visible}}">
                <StackPanel>
                    <TextBlock Text="No backup jobs yet" Style="{StaticResource SectionTitle}" FontSize="16" />
                    <TextBlock Style="{StaticResource Muted}" Text="Create a job: choose the folders to protect, where the encrypted backups go (folder, network share or USB disk) and when it runs." />
                    <Button Content="Create the first job" Command="{Binding NewJobCommand}" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" Margin="0,16,0,0" />
                </StackPanel>
            </Border>
        </Grid>
    </DockPanel>
</UserControl>
