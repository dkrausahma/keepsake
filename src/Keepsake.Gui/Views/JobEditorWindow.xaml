<Window x:Class="Keepsake.Gui.Views.JobEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Keepsake.Gui.ViewModels"
        xmlns:infra="clr-namespace:Keepsake.Gui.Infrastructure"
        Title="{Binding Title}" Width="980" Height="700" MinWidth="820" MinHeight="560"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Style="{StaticResource KeepsakeWindow}">
    <DockPanel Margin="24,20,24,18">
        <!-- Name -->
        <Grid DockPanel.Dock="Top" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="360" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="Job name" VerticalAlignment="Center" Margin="0,0,12,0" FontWeight="SemiBold" />
            <TextBox Grid.Column="1" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" x:Name="NameBox" />
            <CheckBox Grid.Column="2" Content="Enabled (scheduled runs active)" IsChecked="{Binding Enabled}" Margin="18,0,0,0" />
        </Grid>

        <!-- Buttons -->
        <DockPanel DockPanel.Dock="Bottom" Margin="0,14,0,0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="Cancel" IsCancel="True" Margin="0,0,8,0" />
                <Button Content="Save" x:Name="SaveButton" Click="OnSave" Style="{StaticResource PrimaryButton}" Padding="22,6" />
            </StackPanel>
            <TextBlock Text="{Binding Error}" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,16,0" />
        </DockPanel>

        <TabControl Padding="16" BorderBrush="{StaticResource BorderBrush}" Background="{StaticResource SurfaceBrush}">
            <!-- 1. Sources -->
            <TabItem Header="  What to back up  ">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="3*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="2*" />
                    </Grid.ColumnDefinitions>
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Style="{StaticResource Muted}" Margin="0,0,0,8"
                                   Text="Tick folders or files to back up. Untick items inside a ticked folder to exclude them." />
                        <TreeView ItemsSource="{Binding Roots}" BorderBrush="{StaticResource BorderBrush}"
                                  VirtualizingStackPanel.IsVirtualizing="True" VirtualizingStackPanel.VirtualizationMode="Recycling">
                            <TreeView.ItemContainerStyle>
                                <Style TargetType="TreeViewItem">
                                    <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                                    <Setter Property="Padding" Value="1,2" />
                                </Style>
                            </TreeView.ItemContainerStyle>
                            <TreeView.ItemTemplate>
                                <HierarchicalDataTemplate DataType="{x:Type vm:FileTreeNode}" ItemsSource="{Binding Children}">
                                    <StackPanel Orientation="Horizontal">
                                        <CheckBox IsChecked="{Binding IsChecked}" Margin="0,0,6,0" Focusable="False"
                                                  Visibility="{Binding IsCheckable, Converter={StaticResource Visible}}" />
                                        <TextBlock Text="{Binding Name}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsFolder}" Value="True">
                                                            <Setter Property="FontWeight" Value="SemiBold" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock Text="{Binding Hint}" Style="{StaticResource Muted}" Margin="8,0,0,0" FontStyle="Italic" />
                                    </StackPanel>
                                </HierarchicalDataTemplate>
                            </TreeView.ItemTemplate>
                        </TreeView>
                    </DockPanel>

                    <DockPanel Grid.Column="2">
                        <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
                            <TextBlock Text="Add a path that is not in the tree (e.g. \\server\share\folder)" Style="{StaticResource Muted}" Margin="0,0,0,4" />
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Content="Add" Command="{Binding AddPathCommand}" Margin="6,0,0,0" MinWidth="56" />
                                <TextBox x:Name="NewPathBox" Text="{Binding NewPath, UpdateSourceTrigger=PropertyChanged}" />
                            </DockPanel>
                        </StackPanel>
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock Text="Backed up" Style="{StaticResource SectionTitle}" />
                                <TextBlock Text="Nothing selected yet." Style="{StaticResource Muted}"
                                           Visibility="{Binding SelectedSources.Count, Converter={StaticResource Hidden}}" />
                                <ItemsControl ItemsSource="{Binding SelectedSources}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <DockPanel Margin="0,2">
                                                <Button DockPanel.Dock="Right" Content="Remove" Style="{StaticResource LinkButton}" Margin="8,0,0,0"
                                                        Command="{Binding DataContext.RemoveSourceCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" />
                                                <TextBlock Text="{Binding}" TextTrimming="CharacterEllipsis" ToolTip="{Binding}" />
                                            </DockPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <TextBlock Text="Excluded by selection" Style="{StaticResource SectionTitle}" Margin="0,18,0,8" />
                                <TextBlock Text="None." Style="{StaticResource Muted}" Visibility="{Binding SelectedExclusions.Count, Converter={StaticResource Hidden}}" />
                                <ItemsControl ItemsSource="{Binding SelectedExclusions}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <DockPanel Margin="0,2">
                                                <Button DockPanel.Dock="Right" Content="Include again" Style="{StaticResource LinkButton}" Margin="8,0,0,0"
                                                        Command="{Binding DataContext.RemoveSourceCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" />
                                                <TextBlock Text="{Binding}" TextTrimming="CharacterEllipsis" ToolTip="{Binding}" Foreground="{StaticResource MutedBrush}" />
                                            </DockPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </ScrollViewer>
                    </DockPanel>
                </Grid>
            </TabItem>

            <!-- 2. Exclusions -->
            <TabItem Header="  Exclusions  ">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="24" />
                        <ColumnDefinition Width="300" />
                    </Grid.ColumnDefinitions>
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="Exclusion patterns – one per line" Style="{StaticResource SectionTitle}" />
                        <TextBox x:Name="PatternsBox" Text="{Binding Patterns, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" FontFamily="Consolas"
                                 VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto" TextWrapping="NoWrap" />
                    </DockPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Examples" Style="{StaticResource SectionTitle}" />
                        <TextBlock Style="{StaticResource Muted}" FontFamily="Consolas" Text="*.tmp&#10;~$*&#10;Thumbs.db&#10;cache\&#10;D:\Data\Temp&#10;D:\Data\**\obj\" Margin="0,0,0,8" />
                        <TextBlock Style="{StaticResource Muted}"
                                   Text="Without \ the pattern matches file or folder names. A trailing \ means folders only. With \ it matches the full path: * stays within one folder, ** spans folders. Upper/lower case does not matter. Lines starting with # are ignored." />
                        <CheckBox Content="Also exclude the standard system items" IsChecked="{Binding UseDefaultExcludes}" Margin="0,18,0,4" FontWeight="SemiBold" />
                        <ItemsControl ItemsSource="{Binding DefaultExcludes}" Margin="22,0,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" Style="{StaticResource Muted}" FontFamily="Consolas" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Grid>
            </TabItem>

            <!-- 3. Destination -->
            <TabItem Header="  Destination  ">
                <ScrollViewer VerticalScrollBarVisibility="Auto" DataContext="{Binding Destination}">
                    <StackPanel MaxWidth="680" HorizontalAlignment="Left">
                        <TextBlock Text="Where are the backups stored?" Style="{StaticResource SectionTitle}" />
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <RadioButton x:Name="DestFolder" Content="Folder or network share" IsChecked="{Binding IsFolder}" GroupName="DestType" Margin="0,0,18,0" />
                            <RadioButton x:Name="DestUsb" Content="USB disk" IsChecked="{Binding IsUsb}" GroupName="DestType" Margin="0,0,18,0" />
                            <RadioButton x:Name="DestSftp" Content="SFTP server" IsChecked="{Binding IsSftp}" GroupName="DestType" />
                        </StackPanel>

                        <!-- Folder / share -->
                        <StackPanel Visibility="{Binding IsFolder, Converter={StaticResource Visible}}">
                            <TextBlock Text="Folder (local disk or \\server\share\folder)" Style="{StaticResource FieldLabel}" />
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Content="Browse…" Command="{Binding BrowseFolderCommand}" Margin="6,0,0,0" />
                                <TextBox x:Name="DestinationBox" Text="{Binding FolderPath, UpdateSourceTrigger=PropertyChanged}" />
                            </DockPanel>
                            <StackPanel Visibility="{Binding IsShare, Converter={StaticResource Visible}}" Margin="0,8,0,0">
                                <TextBlock Style="{StaticResource Muted}" Text="Optional: connect to the share with its own account (otherwise the service account / computer account is used)." />
                                <Grid Margin="0,4,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="10" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="User (DOMAIN\user)" Style="{StaticResource FieldLabel}" />
                                        <TextBox x:Name="ShareUserBox" Text="{Binding ShareUser, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Password" Style="{StaticResource FieldLabel}" />
                                        <PasswordBox infra:PasswordBinding.Password="{Binding SharePassword, Mode=TwoWay}" />
                                    </StackPanel>
                                </Grid>
                                <TextBlock Text="A share password is stored. Leave the field empty to keep it." Style="{StaticResource Muted}" Margin="0,4,0,0"
                                           Visibility="{Binding HasStoredSharePassword, Converter={StaticResource Visible}}" />
                            </StackPanel>
                        </StackPanel>

                        <!-- USB -->
                        <StackPanel Visibility="{Binding IsUsb, Converter={StaticResource Visible}}">
                            <TextBlock Style="{StaticResource Muted}"
                                       Text="USB disks are recognised by their volume ID, whatever drive letter they get. Register several disks to rotate them; each one holds its own repository." />
                            <TextBlock Text="Disks of this job" Style="{StaticResource FieldLabel}" />
                            <TextBlock Text="No disk registered yet." Style="{StaticResource Muted}" Visibility="{Binding Disks.Count, Converter={StaticResource Hidden}}" />
                            <ItemsControl ItemsSource="{Binding Disks}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <DockPanel Margin="0,3">
                                            <Button DockPanel.Dock="Right" Content="Remove" Style="{StaticResource LinkButton}" Margin="12,0,0,0"
                                                    Command="{Binding DataContext.RemoveDiskCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" />
                                            <Button DockPanel.Dock="Right" Content="Prepare this disk" Style="{StaticResource LinkButton}" Margin="12,0,0,0"
                                                    Command="{Binding DataContext.PrepareDiskCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" />
                                            <TextBlock>
                                                <Run Text="{Binding Display, Mode=OneWay}" FontWeight="SemiBold" /><Run Text="  ·  " /><Run Text="{Binding State, Mode=OneWay}" Foreground="{StaticResource MutedBrush}" />
                                            </TextBlock>
                                        </DockPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <DockPanel Margin="0,10,0,0">
                                <Button DockPanel.Dock="Right" Content="Refresh" Command="{Binding RefreshVolumesCommand}" Margin="6,0,0,0" />
                                <Button DockPanel.Dock="Right" Content="Add disk" Command="{Binding AddDiskCommand}" Margin="6,0,0,0" />
                                <ComboBox ItemsSource="{Binding AvailableVolumes}" SelectedItem="{Binding SelectedVolume}" DisplayMemberPath="Display" />
                            </DockPanel>
                            <TextBlock Text="Folder on the disk (without drive letter)" Style="{StaticResource FieldLabel}" />
                            <TextBox x:Name="UsbFolderBox" Text="{Binding UsbFolder, UpdateSourceTrigger=PropertyChanged}" Width="320" HorizontalAlignment="Left" />
                        </StackPanel>

                        <!-- SFTP -->
                        <StackPanel Visibility="{Binding IsSftp, Converter={StaticResource Visible}}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="90" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Server" Style="{StaticResource FieldLabel}" />
                                    <TextBox x:Name="SftpHostBox" Text="{Binding Host, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Port" Style="{StaticResource FieldLabel}" />
                                    <TextBox x:Name="SftpPortBox" Text="{Binding Port, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                            </Grid>
                            <TextBlock Text="User" Style="{StaticResource FieldLabel}" />
                            <TextBox x:Name="SftpUserBox" Text="{Binding User, UpdateSourceTrigger=PropertyChanged}" Width="320" HorizontalAlignment="Left" />
                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <RadioButton Content="Password" IsChecked="{Binding AuthIsPassword}" GroupName="SftpAuth" Margin="0,0,18,0" />
                                <RadioButton Content="Private key" IsChecked="{Binding AuthIsKey}" GroupName="SftpAuth" />
                            </StackPanel>
                            <StackPanel Visibility="{Binding AuthIsPassword, Converter={StaticResource Visible}}">
                                <TextBlock Text="SFTP password" Style="{StaticResource FieldLabel}" />
                                <PasswordBox x:Name="SftpPasswordBox" infra:PasswordBinding.Password="{Binding SftpPassword, Mode=TwoWay}" Width="320" HorizontalAlignment="Left" />
                                <TextBlock Text="An SFTP password is stored. Leave empty to keep it." Style="{StaticResource Muted}" Margin="0,4,0,0"
                                           Visibility="{Binding HasStoredSftpPassword, Converter={StaticResource Visible}}" />
                            </StackPanel>
                            <StackPanel Visibility="{Binding AuthIsKey, Converter={StaticResource Visible}}">
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <Button Content="Load key file…" Command="{Binding LoadKeyCommand}" />
                                    <TextBlock Text="{Binding KeyStatus}" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="10,0,0,0" />
                                </StackPanel>
                                <TextBlock Text="Key passphrase (if the key is protected)" Style="{StaticResource FieldLabel}" />
                                <PasswordBox infra:PasswordBinding.Password="{Binding KeyPassphrase, Mode=TwoWay}" Width="320" HorizontalAlignment="Left" />
                            </StackPanel>
                            <TextBlock Text="Remote folder" Style="{StaticResource FieldLabel}" />
                            <TextBox x:Name="SftpPathBox" Text="{Binding RemotePath, UpdateSourceTrigger=PropertyChanged}" Width="320" HorizontalAlignment="Left" />
                            <DockPanel Margin="0,10,0,0">
                                <Button DockPanel.Dock="Right" Content="Forget" Command="{Binding ForgetHostKeyCommand}" Style="{StaticResource LinkButton}" Margin="10,0,0,0" />
                                <TextBlock Text="{Binding HostKeyText}" Style="{StaticResource Muted}" TextWrapping="Wrap" />
                            </DockPanel>
                        </StackPanel>

                        <!-- Repository password -->
                        <TextBlock Text="Repository password (encrypts the backups)" Style="{StaticResource FieldLabel}" Margin="0,18,0,4" />
                        <PasswordBox x:Name="RepoPassword" infra:PasswordBinding.Password="{Binding RepoPassword, Mode=TwoWay}" Width="320" HorizontalAlignment="Left" />
                        <TextBlock Text="Repeat password (only needed for a new repository)" Style="{StaticResource FieldLabel}" />
                        <PasswordBox x:Name="RepoConfirm" infra:PasswordBinding.Password="{Binding RepoConfirm, Mode=TwoWay}" Width="320" HorizontalAlignment="Left" />

                        <Button Content="Check destination" Command="{Binding CheckCommand}" HorizontalAlignment="Left" Margin="0,14,0,0" />
                        <Border Margin="0,12,0,0" Padding="12,8" CornerRadius="4" Background="{StaticResource AccentSoftBrush}">
                            <TextBlock Text="{Binding Status}" TextWrapping="Wrap" />
                        </Border>
                        <TextBlock Style="{StaticResource Muted}" Margin="0,14,0,0"
                                   Text="The repository password is stored on this server (protected by Windows) so scheduled backups can run. A new repository also gets a recovery key – store both in KeePass. Without them the backups cannot be restored." />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- 4. Schedule -->
            <TabItem Header="  Schedule  ">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="320" />
                        <ColumnDefinition Width="24" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,0">
                            <Button Content="Add schedule" Command="{Binding AddScheduleCommand}" Margin="0,0,6,0" />
                            <Button Content="Remove" Command="{Binding RemoveScheduleCommand}" Style="{StaticResource DangerButton}" />
                        </StackPanel>
                        <TextBlock DockPanel.Dock="Top" Text="No schedule = manual runs only." Style="{StaticResource Muted}" Margin="0,0,0,8" />
                        <ListBox ItemsSource="{Binding Schedules}" SelectedItem="{Binding SelectedSchedule}" BorderBrush="{StaticResource BorderBrush}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Summary}" Padding="4,6" TextWrapping="Wrap" />
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>

                    <StackPanel Grid.Column="2" DataContext="{Binding SelectedSchedule}"
                                Visibility="{Binding Converter={StaticResource Visible}}">
                        <CheckBox Content="Schedule active" IsChecked="{Binding Enabled}" />
                        <TextBlock Text="Repeat" Style="{StaticResource FieldLabel}" />
                        <ComboBox ItemsSource="{x:Static vm:ScheduleItemViewModel.Kinds}" SelectedItem="{Binding Kind}" Width="200" HorizontalAlignment="Left" />

                        <StackPanel Visibility="{Binding HasTimes, Converter={StaticResource Visible}}">
                            <TextBlock Text="At (HH:mm, several separated by commas)" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding Times, UpdateSourceTrigger=PropertyChanged}" Width="200" HorizontalAlignment="Left" />
                        </StackPanel>

                        <StackPanel Visibility="{Binding IsDaily, Converter={StaticResource Visible}}">
                            <TextBlock Text="On (none ticked = every day)" Style="{StaticResource FieldLabel}" />
                            <ItemsControl ItemsSource="{Binding WeekdaysMondayFirst}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <CheckBox Content="{Binding Label}" IsChecked="{Binding IsSelected}" Margin="0,0,14,0" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <StackPanel Visibility="{Binding IsMonthly, Converter={StaticResource Visible}}">
                            <TextBlock Text="On days of the month (e.g. 1, 15; 31 = last day)" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding Days, UpdateSourceTrigger=PropertyChanged}" Width="200" HorizontalAlignment="Left" />
                        </StackPanel>

                        <StackPanel Visibility="{Binding IsInterval, Converter={StaticResource Visible}}">
                            <TextBlock Text="Every … minutes (at least 5)" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding IntervalMinutes, UpdateSourceTrigger=PropertyChanged}" Width="120" HorizontalAlignment="Left" />
                        </StackPanel>

                        <TextBlock Text="Backup type" Style="{StaticResource FieldLabel}" />
                        <ComboBox ItemsSource="{x:Static vm:ScheduleItemViewModel.Modes}" SelectedItem="{Binding Mode}" Width="200" HorizontalAlignment="Left" />
                        <TextBlock Style="{StaticResource Muted}" Margin="0,6,0,0"
                                   Text="Incremental only reads changed files. Full re-reads every file (slower, catches silent changes). Every backup is a complete snapshot either way." />
                    </StackPanel>
                </Grid>
            </TabItem>

            <!-- 5. Retention and checks -->
            <TabItem Header="  Retention &amp; checks  ">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="360" />
                            <ColumnDefinition Width="24" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Which backups to keep" Style="{StaticResource SectionTitle}" />
                            <TextBlock Style="{StaticResource Muted}" Text="A backup is kept if any rule keeps it; 0 turns a rule off. All 0 = keep everything. Protected backups are never removed." />
                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="200" />
                                    <ColumnDefinition Width="70" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
                                </Grid.RowDefinitions>
                                <TextBlock Text="Last backups" VerticalAlignment="Center" />
                                <TextBox Grid.Column="1" Text="{Binding KeepLast}" Margin="0,2" />
                                <TextBlock Grid.Row="1" Text="One per day, for … days" VerticalAlignment="Center" />
                                <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding KeepDaily}" Margin="0,2" />
                                <TextBlock Grid.Row="2" Text="One per week, for … weeks" VerticalAlignment="Center" />
                                <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding KeepWeekly}" Margin="0,2" />
                                <TextBlock Grid.Row="3" Text="One per month, for … months" VerticalAlignment="Center" />
                                <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding KeepMonthly}" Margin="0,2" />
                                <TextBlock Grid.Row="4" Text="One per year, for … years" VerticalAlignment="Center" />
                                <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding KeepYearly}" Margin="0,2" />
                                <TextBlock Grid.Row="5" Text="Everything from the last … days" VerticalAlignment="Center" />
                                <TextBox Grid.Row="5" Grid.Column="1" Text="{Binding KeepWithinDays}" Margin="0,2" />
                            </Grid>
                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <TextBlock Text="Clean up every" VerticalAlignment="Center" />
                                <TextBox Text="{Binding PruneEveryDays}" Width="48" Margin="8,0" />
                                <TextBlock Text="days (after a backup; 0 = never)" VerticalAlignment="Center" />
                            </StackPanel>

                            <TextBlock Text="Integrity checks" Style="{StaticResource SectionTitle}" Margin="0,22,0,8" />
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Check every" VerticalAlignment="Center" />
                                <TextBox Text="{Binding CheckEveryDays}" Width="48" Margin="8,0" />
                                <TextBlock Text="days, reading" VerticalAlignment="Center" />
                                <TextBox Text="{Binding CheckPercent}" Width="48" Margin="8,0" />
                                <TextBlock Text="% of the data" VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock Style="{StaticResource Muted}" Margin="0,6,0,0" Text="Every check verifies the structure; the sample is decrypted and compared. A random sample each time covers all data over time." />

                            <TextBlock Text="Notifications (e-mail, see Settings)" Style="{StaticResource SectionTitle}" Margin="0,22,0,8" />
                            <CheckBox Content="When a run fails" IsChecked="{Binding NotifyOnFailure}" />
                            <CheckBox Content="When a run has warnings (files not backed up)" IsChecked="{Binding NotifyOnWarning}" />
                            <CheckBox Content="After every successful backup" IsChecked="{Binding NotifyOnSuccess}" />
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <TextBlock Text="Alert if no successful backup for" VerticalAlignment="Center" />
                                <TextBox Text="{Binding AlertNoSuccessHours}" Width="48" Margin="8,0" />
                                <TextBlock Text="hours (0 = off)" VerticalAlignment="Center" />
                            </StackPanel>
                        </StackPanel>

                        <DockPanel Grid.Column="2">
                            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                                <Button Content="Preview cleanup" Command="{Binding PreviewRetentionCommand}" />
                                <TextBlock Text="(for saved jobs with backups)" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="10,0,0,0" />
                            </StackPanel>
                            <TextBox Text="{Binding PreviewText, Mode=OneWay}" Style="{StaticResource Mono}" MinHeight="200" />
                        </DockPanel>
                    </Grid>
                </ScrollViewer>
            </TabItem>

            <!-- 6. Options -->
            <TabItem Header="  Options  ">
                <StackPanel MaxWidth="640" HorizontalAlignment="Left">
                    <CheckBox Content="Run a missed backup once after the server starts (e.g. after it was switched off)" IsChecked="{Binding RunMissed}" />
                    <CheckBox Content="Use VSS snapshots so open and locked files are backed up (recommended)" IsChecked="{Binding UseVss}" />

                    <TextBlock Text="When a scheduled backup fails" Style="{StaticResource FieldLabel}" Margin="0,16,0,4" />
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Retry" VerticalAlignment="Center" />
                        <TextBox Text="{Binding RetryCount}" Width="48" Margin="8,0" />
                        <TextBlock Text="times, after" VerticalAlignment="Center" />
                        <TextBox Text="{Binding RetryDelay}" Width="56" Margin="8,0" />
                        <TextBlock Text="minutes" VerticalAlignment="Center" />
                    </StackPanel>

                    <TextBlock Text="Command before the backup (cmd.exe; a non-zero exit code cancels the backup)" Style="{StaticResource FieldLabel}" Margin="0,16,0,4" />
                    <TextBox Text="{Binding PreCommand}" FontFamily="Consolas" />
                    <TextBlock Text="Command after the backup (always runs; KEEPSAKE_STATUS holds success / warning / failed)" Style="{StaticResource FieldLabel}" />
                    <TextBox Text="{Binding PostCommand}" FontFamily="Consolas" />
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <TextBlock Text="Command timeout" VerticalAlignment="Center" />
                        <TextBox Text="{Binding CommandTimeout}" Width="56" Margin="8,0" />
                        <TextBlock Text="minutes" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Text="Network shares used as sources" Style="{StaticResource FieldLabel}" Margin="0,20,0,4" FontWeight="SemiBold" />
                    <TextBlock Style="{StaticResource Muted}" Text="Credentials for shares the job reads from. Without an entry the service account (computer account) is used." />
                    <Grid Margin="0,8,0,0" Visibility="{Binding ExtraShares.Count, Converter={StaticResource Visible}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="1.5*" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="1.5*" />
                            <ColumnDefinition Width="58" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Share (\\server\share)" Style="{StaticResource Muted}" />
                        <TextBlock Grid.Column="2" Text="User (DOMAIN\user)" Style="{StaticResource Muted}" />
                        <TextBlock Grid.Column="4" Text="Password" Style="{StaticResource Muted}" />
                    </Grid>
                    <ItemsControl ItemsSource="{Binding ExtraShares}" Margin="0,2,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="2*" />
                                        <ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="1.5*" />
                                        <ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="1.5*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox Text="{Binding Share, UpdateSourceTrigger=PropertyChanged}" ToolTip="\\server\share" />
                                    <TextBox Grid.Column="2" Text="{Binding User, UpdateSourceTrigger=PropertyChanged}" ToolTip="DOMAIN\user" />
                                    <PasswordBox Grid.Column="4" infra:PasswordBinding.Password="{Binding Password, Mode=TwoWay}" ToolTip="{Binding PasswordHint}" />
                                    <Button Grid.Column="5" Content="Remove" Style="{StaticResource LinkButton}" Margin="10,0,0,0" VerticalAlignment="Center"
                                            Command="{Binding DataContext.RemoveShareCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Button Content="Add share" Command="{Binding AddShareCommand}" HorizontalAlignment="Left" Margin="0,6,0,0" />
                </StackPanel>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
