<UserControl x:Class="Keepsake.Gui.Views.HistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel>
        <Grid DockPanel.Dock="Top" Margin="0,0,0,16">
            <StackPanel>
                <TextBlock Text="History &amp; logs" Style="{StaticResource PageTitle}" />
                <TextBlock Text="Every backup and restore with its result. Double-click a run for its full log and the list of everything that was not backed up." Style="{StaticResource Muted}" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button Content="Show details" Command="{Binding OpenCommand}" CommandParameter="{Binding SelectedRun}" Margin="0,0,10,0" />
                <ComboBox ItemsSource="{Binding Jobs}" SelectedItem="{Binding Job}" DisplayMemberPath="Name" Width="220" />
            </StackPanel>
        </Grid>

        <DataGrid x:Name="Grid" ItemsSource="{Binding Runs}" SelectedItem="{Binding SelectedRun}" MouseDoubleClick="OnDoubleClick">
            <DataGrid.Columns>
                <DataGridTemplateColumn Header="Result" Width="110">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Style="{StaticResource StatusDot}" Fill="{Binding State, Converter={StaticResource StateBrush}}" />
                                <TextBlock Text="{Binding State}" Foreground="{Binding State, Converter={StaticResource StateBrush}}" />
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Started" Binding="{Binding Start}" Width="150" />
                <DataGridTextColumn Header="Job" Binding="{Binding Job}" Width="150" />
                <DataGridTextColumn Header="Type" Binding="{Binding Kind}" Width="100" />
                <DataGridTextColumn Header="Trigger" Binding="{Binding Trigger}" Width="80" />
                <DataGridTextColumn Header="Duration" Binding="{Binding Duration}" Width="80" />
                <DataGridTextColumn Header="Files" Binding="{Binding Files}" Width="140" />
                <DataGridTextColumn Header="Data" Binding="{Binding Data}" Width="170" />
                <DataGridTextColumn Header="Message" Binding="{Binding Message}" Width="*" />
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</UserControl>
